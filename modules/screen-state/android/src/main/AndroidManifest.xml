<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <application>
    <!-- Som de fundo do voo sem controle de mídia (FlightSoundService.kt). -->
    <service
      android:name="expo.modules.screenstate.FlightSoundService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
    <!-- Sinal de cintos e aviso de pouso tocados pelo app na hora do alarme (SinalDeBordo.kt). -->
    <receiver
      android:name="expo.modules.screenstate.SinalDeBordo$Receptor"
      android:exported="false" />
  </application>
</manifest>
