# ─────────────────────────────────────────────────────────────
# Termi: Focus Flights — variáveis de ambiente do app
# Copie para .env e preencha. Nunca commite o .env.
#
# ATENÇÃO: toda variável com prefixo EXPO_PUBLIC_ é embutida no
# app e fica visível para qualquer pessoa. Só coloque aqui valores
# públicos. Segredos (chave do adsb.lol, credenciais de escrita do
# R2, chaves secretas do RevenueCat) NÃO pertencem a este arquivo:
# ficam no coletor de voos ou no painel do serviço.
# ─────────────────────────────────────────────────────────────

# ── Ambiente (lido no app.config.ts) ──────────────────────────
# development | preview | production
APP_ENV=development

# ── Públicas: dados servidos pela CDN (Cloudflare R2) ─────────
# Base dos arquivos de voos por região: {base}/voos/{regiao}.json
EXPO_PUBLIC_FLIGHT_CACHE_URL=https://dados.example.com

# Base dos blocos da paisagem da janela (Landsat, GMIS, Blue/Black Marble)
EXPO_PUBLIC_TILES_BASE_URL=https://blocos.example.com

# Base de renders da janela, sons e modelos 3D dos souvenirs
EXPO_PUBLIC_ASSETS_BASE_URL=https://assets.example.com

# Idade máxima do cache de voos antes de tratar como "dados fora do ar" (minutos)
# [Proposta] valor a validar
EXPO_PUBLIC_FLIGHT_CACHE_MAX_AGE_MIN=45

# ── Públicas: compras (RevenueCat) ───────────────────────────
# Chave PÚBLICA do SDK (começa com goog_ no Android). Não use a chave secreta.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# iOS fica para depois do lançamento no Android
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Públicas: monitoramento de erros [Proposta: Sentry] ──────
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# ── Públicas: conta e sincronização [Pendente: provedor não escolhido] ──
# Exemplo, se for Supabase (a anon key é pública por definição):
# EXPO_PUBLIC_SYNC_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SYNC_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Privadas: só no ambiente de build (EAS/CI), nunca no app ──
# Token para enviar source maps ao Sentry durante o build [Proposta]
# SENTRY_AUTH_TOKEN=
